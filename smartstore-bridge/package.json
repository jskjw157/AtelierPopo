{
  "name": "atelier-popo-smartstore-bridge",
  "version": "0.6.0",
  "private": true,
  "description": "HAAR/아뜰리에포포 전용 다중 공급처 상품카탈로그 + 네이버 커머스API + SearchAd + Google Drive 운영 브리지",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "atelier-popo": "./src/cli.js",
    "atelier-popo-mcp": "./src/mcp.js",
    "atelier-popo-http": "./src/http-v05.js"
  },
  "scripts": {
    "start": "node src/http-v05.js",
    "http": "node src/http-v05.js",
    "http:v04": "node src/http-v04.js",
    "http:v03": "node src/http-v03.js",
    "http:legacy": "node src/http.js",
    "cli": "node src/cli.js",
    "mcp": "node src/mcp.js",
    "drive:oauth": "node scripts/google-drive-oauth.mjs",
    "postgres:migrate": "node scripts/postgres-migrate.mjs",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check-syntax.mjs",
    "inspect:mcp": "npx @modelcontextprotocol/inspector node src/mcp.js",
    "test:remote": "node scripts/remote-smoke-test.mjs",
    "test:drive:remote": "node scripts/drive-remote-smoke.mjs",
    "commerce:spec:sync": "node scripts/naver-commerce-spec-sync.mjs",
    "commerce:coverage": "node scripts/naver-commerce-coverage.mjs",
    "test:commerce:remote": "node scripts/commerce-remote-smoke.mjs",
    "searchad:spec:sync": "node scripts/searchad-spec-sync.mjs",
    "searchad:coverage": "node scripts/searchad-coverage.mjs",
    "searchad:status": "node scripts/searchad-status.mjs",
    "test:searchad:remote": "node scripts/searchad-remote-smoke.mjs",
    "catalog:sources:status": "node scripts/multi-source-status.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "pg": "^8.16.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}
