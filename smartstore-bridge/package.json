{
  "name": "atelier-popo-smartstore-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "아뜰리에포포 전용 퀸실버 → 네이버 스마트스토어 상품 등록 CLI/MCP",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "atelier-popo": "./src/cli.js",
    "atelier-popo-mcp": "./src/mcp.js"
  },
  "scripts": {
    "cli": "node src/cli.js",
    "mcp": "node src/mcp.js",
    "test": "node --test",
    "check": "node --check src/cli.js && node --check src/mcp.js",
    "inspect:mcp": "npx @modelcontextprotocol/inspector node src/mcp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "bcryptjs": "^3.0.3",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  }
}
