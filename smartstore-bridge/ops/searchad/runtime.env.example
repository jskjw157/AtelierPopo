# INCOMPLETE PREPARATION TEMPLATE: not loaded into the running Commerce service.
NODE_ENV=production
DATABASE_URL=
ATELIER_POSTGRES_SSL_MODE=verify-full
NODE_EXTRA_CA_CERTS=/run/searchad-tls/ca.crt
# DATABASE_URL must not contain sslmode/sslcert/sslkey/sslrootcert query options.

ATELIER_SEARCHAD_GATEWAY_ENABLED=false
ATELIER_SEARCHAD_AUTOMATION_MODE=observe
ATELIER_SEARCHAD_ALLOW_READS=false
ATELIER_SEARCHAD_ALLOW_BILLING_READS=false
ATELIER_SEARCHAD_ALLOW_REPORTING_JOBS=false
ATELIER_SEARCHAD_ALLOW_ACTIVE_CANARY=false
ATELIER_SEARCHAD_ALLOW_WRITES=false
ATELIER_SEARCHAD_ALLOW_CREATES=false
ATELIER_SEARCHAD_ALLOW_BATCH_WRITES=false
ATELIER_SEARCHAD_ALLOW_DELETES=false
ATELIER_SEARCHAD_ALLOW_ROLLBACK=false
ATELIER_SEARCHAD_ALLOW_ACCOUNT_ADMIN=false
ATELIER_SEARCHAD_ALLOW_UNVERIFIED_OPERATIONS=false
ATELIER_SEARCHAD_WORKER_ENABLED=false
ATELIER_SEARCHAD_WORKER_CUSTOMERS=
ATELIER_SEARCHAD_WORKER_PRINCIPAL_ID=

# Real topology and separately scoped HTTP keys must be provisioned privately.
# No single-credential fallback or fabricated grants.
NAVER_SEARCHAD_PRINCIPALS_JSON=[]
NAVER_SEARCHAD_CUSTOMERS_JSON=[]
NAVER_SEARCHAD_GRANTS_JSON=[]
ATELIER_SEARCHAD_READER_API_KEY=
ATELIER_SEARCHAD_READER_CUSTOMERS=
ATELIER_SEARCHAD_READER_PRINCIPAL_ID=
ATELIER_SEARCHAD_OPERATOR_API_KEY=
ATELIER_SEARCHAD_OPERATOR_CUSTOMERS=
ATELIER_SEARCHAD_OPERATOR_PRINCIPAL_ID=
ATELIER_SEARCHAD_EXECUTOR_API_KEY=
ATELIER_SEARCHAD_EXECUTOR_CUSTOMERS=
ATELIER_SEARCHAD_EXECUTOR_PRINCIPAL_ID=
ATELIER_SEARCHAD_ADMIN_API_KEY=
ATELIER_SEARCHAD_ADMIN_CUSTOMERS=
ATELIER_SEARCHAD_ADMIN_PRINCIPAL_ID=

# Required production ingestion remains unready until a real durable bucket exists.
ATELIER_SEARCHAD_REPORTING_ENABLED=true
ATELIER_SEARCHAD_REPORT_INGESTION_REQUIRED=true
ATELIER_SEARCHAD_REPORT_S3_BUCKET=
ATELIER_SEARCHAD_REPORT_S3_REGION=
ATELIER_SEARCHAD_REPORT_S3_ENDPOINT=
ATELIER_SEARCHAD_REPORT_S3_PREFIX=reports
# Configure AWS_PROFILE / AWS_SHARED_CREDENTIALS_FILE only after its private file
# is provisioned and mounted read-only. Do not copy unrelated application keys.
# Clock/rollout uncertainty requires an explicit justified policy; left unset.
