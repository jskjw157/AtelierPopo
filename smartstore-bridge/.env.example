ATELIER_EXPOSE_INTERNAL_ERRORS=false

# ─────────────────────────────────────────────────────────────────────────────
# 네이버 커머스API 전체 operation gateway (공식 인덱스 116개)
# ─────────────────────────────────────────────────────────────────────────────
ATELIER_COMMERCE_GATEWAY_ENABLED=true
NAVER_COMMERCE_MANIFEST_PATH=./specs/naver-commerce/current.json
