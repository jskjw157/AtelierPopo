# ─────────────────────────────────────────────────────────────────────────────
# 네이버 커머스API센터 > 내 정보 > 내 스토어 애플리케이션
# ─────────────────────────────────────────────────────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_TOKEN_TYPE=SELF
NAVER_ACCOUNT_ID=
NAVER_BASE_URL=https://api.commerce.naver.com/external
NAVER_ALLOW_WRITES=false

# ─────────────────────────────────────────────────────────────────────────────
# 애플리케이션 파일/데이터 경로
# ─────────────────────────────────────────────────────────────────────────────
ATELIER_POPO_CONFIG=./config/atelier-popo.example.json
ATELIER_CATALOG_PROVIDER=google-drive
ATELIER_CATALOG_ROOT=
ATELIER_TEMPLATE_FILE=
ATELIER_WORK_DIR=./work
ATELIER_DATABASE_PATH=./work/atelier-popo.sqlite

# ─────────────────────────────────────────────────────────────────────────────
# HAAR 다중 공급처·다중 상품소스
# 퀸실버는 첫 번째 Source일 뿐 플랫폼 전체 상품 기준이 아닙니다.
# ─────────────────────────────────────────────────────────────────────────────
ATELIER_MULTI_SOURCE_CATALOG_ENABLED=true
ATELIER_MULTI_SOURCE_CACHE_DIR=/tmp/atelier-drive-cache/catalog-sources
ATELIER_DEFAULT_CATALOG_SOURCE_ID=queensilver_20260811
ATELIER_QUEENSILVER_SOURCE_ID=queensilver_20260811
ATELIER_QUEENSILVER_SOURCE_NAME=퀸실버_전체상품_20260811

# 여러 공급처를 연결할 때 JSON 배열을 사용합니다.
# 예: [{"sourceId":"supplier_b","sourceName":"공급처 B","sourceType":"supplier","providerType":"google_drive_manifest","rootReference":"DRIVE_FOLDER_ID"}]
ATELIER_CATALOG_SOURCES_JSON=

# HAAR 판매 채널은 현재 2개입니다.
# 1) 네이버 스마트스토어
# 2) HAAR 자사몰 — Cafe24 플랫폼, haar.co.kr 도메인
# Cafe24와 OWN_SITE를 서로 다른 두 채널로 등록하지 않습니다.
ATELIER_NAVER_CHANNEL_ID=haar_naver_smartstore
ATELIER_NAVER_CHANNEL_NAME=HAAR 네이버 스마트스토어
ATELIER_OWN_MALL_CHANNEL_ID=haar_own_mall
ATELIER_OWN_MALL_CHANNEL_NAME=HAAR 자사몰
CAFE24_MALL_ID=
HAAR_OWN_MALL_DOMAIN=haar.co.kr

# 여러 판매 채널을 직접 정의할 때만 JSON 배열을 사용합니다.
# channelRole은 사업상 역할, platformType은 운영 플랫폼입니다.
# 예: [{"channelId":"haar_own_mall","channelName":"HAAR 자사몰","channelRole":"owned_store","platformType":"cafe24","primaryDomain":"haar.co.kr"}]
ATELIER_SALES_CHANNELS_JSON=

