# ─────────────────────────────────────────────────────────────────────────────
# 네이버 커머스API센터 > 내 정보 > 내 스토어 애플리케이션
# ─────────────────────────────────────────────────────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_TOKEN_TYPE=SELF
NAVER_ACCOUNT_ID=
NAVER_BASE_URL=https://api.commerce.naver.com/external

# 핵심 쓰기 잠금. 실제 상품 등록을 할 때만 true로 변경합니다.
NAVER_ALLOW_WRITES=false

# ─────────────────────────────────────────────────────────────────────────────
# 애플리케이션 파일/데이터 경로
# 상대 경로는 프로세스 실행 디렉터리를 기준으로 해석됩니다.
# ─────────────────────────────────────────────────────────────────────────────
ATELIER_POPO_CONFIG=./config/atelier-popo.example.json
ATELIER_CATALOG_ROOT=
ATELIER_TEMPLATE_FILE=
ATELIER_WORK_DIR=./work
ATELIER_DATABASE_PATH=./work/atelier-popo.sqlite

# ─────────────────────────────────────────────────────────────────────────────
# Hostinger HTTP API
# 최소 32자 이상의 랜덤 문자열을 사용하세요. 쉼표로 여러 키를 등록하려면
# ATELIER_API_KEYS=key1,key2 형식을 사용할 수 있습니다.
# ─────────────────────────────────────────────────────────────────────────────
ATELIER_API_KEY=
ATELIER_API_KEYS=
ATELIER_API_KEY_MIN_LENGTH=32
ATELIER_HTTP_HOST=0.0.0.0
PORT=3000

# 원격 쓰기는 NAVER_ALLOW_WRITES와 아래 값을 모두 true로 해야 합니다.
ATELIER_HTTP_ALLOW_WRITES=false
ATELIER_HTTP_ALLOW_BATCH_WRITES=false

# 운영 설정
ATELIER_TRUST_PROXY=true
ATELIER_CORS_ORIGINS=
ATELIER_MAX_BODY_BYTES=65536
ATELIER_RATE_LIMIT_PER_MINUTE=120
ATELIER_WRITE_RATE_LIMIT_PER_MINUTE=20
ATELIER_REQUEST_TIMEOUT_MS=30000
ATELIER_SHUTDOWN_TIMEOUT_MS=30000
ATELIER_OPERATION_CONCURRENCY=1
ATELIER_EXPOSE_INTERNAL_ERRORS=false
