# ─────────────────────────────────────────────────────────────────────────────
# 네이버 검색광고 SearchAd — 최초 배포는 read-only / observe
# 광고주센터 > 도구 > SA API 사용 관리에서 발급한 값만 사용합니다.
# ─────────────────────────────────────────────────────────────────────────────
NAVER_SEARCHAD_BASE_URL=https://api.searchad.naver.com
NAVER_SEARCHAD_ACCESS_LICENSE=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=
NAVER_SEARCHAD_PRINCIPAL_ID=default

# 여러 Principal / Customer를 연결할 때만 JSON 배열을 사용합니다.
NAVER_SEARCHAD_PRINCIPALS_JSON=
NAVER_SEARCHAD_CUSTOMERS_JSON=
NAVER_SEARCHAD_GRANTS_JSON=

ATELIER_SEARCHAD_GATEWAY_ENABLED=true
NAVER_SEARCHAD_MANIFEST_PATH=./specs/naver-searchad/current.json
NAVER_SEARCHAD_SOURCE_MANIFEST_PATH=./specs/naver-searchad/source-manifest.json
NAVER_SEARCHAD_COMPILED_CORRECTIONS_PATH=./specs/naver-searchad/corrections/compiled.json
ATELIER_SEARCHAD_REQUEST_TIMEOUT_MS=30000
ATELIER_SEARCHAD_MAX_RETRIES=3
ATELIER_SEARCHAD_MAX_JSON_BODY_BYTES=8388608
ATELIER_SEARCHAD_PASSIVE_PROBE_LIMIT=12
ATELIER_SEARCHAD_INCREMENTAL_SYNC_INTERVAL_MS=300000

# 초기 운영 Gate
ATELIER_SEARCHAD_ALLOW_READS=true
ATELIER_SEARCHAD_ALLOW_WRITES=false
ATELIER_SEARCHAD_ALLOW_CREATES=false
ATELIER_SEARCHAD_ALLOW_BATCH_WRITES=false
ATELIER_SEARCHAD_ALLOW_ROLLBACK=false
ATELIER_SEARCHAD_ALLOW_DELETES=false
ATELIER_SEARCHAD_ALLOW_BILLING_READS=true
ATELIER_SEARCHAD_ALLOW_ACCOUNT_ADMIN=false
ATELIER_SEARCHAD_ALLOW_ACTIVE_CANARY=false
ATELIER_SEARCHAD_ALLOW_UNVERIFIED_OPERATIONS=false
ATELIER_SEARCHAD_AUTOMATION_MODE=observe

# 자동화 Circuit Breaker Seed
ATELIER_ADS_ENTITY_COOLDOWN_HOURS=24
ATELIER_ADS_MANUAL_CHANGE_HOLD_HOURS=24
