# SearchAd write execution is an activation target.
# Keep all production mutation gates OFF until the matching real-account evidence exists.

ATELIER_SEARCHAD_WRITE_EXECUTION_ENABLED=true
ATELIER_SEARCHAD_ALLOW_CHANGE_PLANS=true
ATELIER_SEARCHAD_ALLOW_WRITES=false
ATELIER_SEARCHAD_ALLOW_ROLLBACK=false
ATELIER_SEARCHAD_ALLOW_RECONCILE=true
ATELIER_SEARCHAD_ALLOW_ACTIVE_CANARY=false
ATELIER_SEARCHAD_ACTIVATION_MODE=prevalidation
ATELIER_SEARCHAD_WRITE_DB_PATH=./work/searchad-write.sqlite
ATELIER_SEARCHAD_PLAN_TTL_SECONDS=1800
ATELIER_SEARCHAD_APPROVAL_TTL_SECONDS=600

# Active Canary persistence uses PostgreSQL and the normal platform DATABASE_URL.
# DATABASE_URL=
# ATELIER_POSTGRES_SSL_MODE=require

# -----------------------------------------------------------------------------
# Live Active Canary window — enable ONLY after valid stored Passive Capability
# evidence exists for the exact Customer/spec/credential/upstream/operation scope.
# Do NOT enable the ordinary create/write/delete gates merely to run Canary.
# -----------------------------------------------------------------------------
# ATELIER_SEARCHAD_ALLOW_ACTIVE_CANARY=true
# ATELIER_SEARCHAD_ACTIVATION_MODE=canary
# ATELIER_SEARCHAD_CANARY_OBSERVATION_SECONDS=172800
# ATELIER_SEARCHAD_CANARY_EVIDENCE_TTL_SECONDS=86400
# ATELIER_SEARCHAD_CANARY_MAX_SPEND_KRW=0
# ATELIER_SEARCHAD_CANARY_MAX_CONCURRENT_PER_CUSTOMER=1
# ATELIER_SEARCHAD_CANARY_MAX_OBJECTS=4
# ATELIER_SEARCHAD_CANARY_MAX_MUTATIONS=12
# ATELIER_SEARCHAD_CANARY_TTL_SECONDS=3600
#
# The following monetary values are intentionally NOT given defaults.
# Set them only after the official ad-product validator and operator ceiling are confirmed.
# The configured daily budget + mutation delta must not exceed MAX_DAILY_BUDGET_KRW.
# ATELIER_SEARCHAD_CANARY_DAILY_BUDGET_KRW=
# ATELIER_SEARCHAD_CANARY_BUDGET_DELTA_KRW=
# ATELIER_SEARCHAD_CANARY_MAX_DAILY_BUDGET_KRW=
# ATELIER_SEARCHAD_CANARY_MAX_BUDGET_DELTA_KRW=
#
# Exact stats range used by the stopped-campaign Canary evidence recipe.
# ATELIER_SEARCHAD_CANARY_STATS_SINCE=YYYY-MM-DD
# ATELIER_SEARCHAD_CANARY_STATS_UNTIL=YYYY-MM-DD

# -----------------------------------------------------------------------------
# After a real Canary has completed cleanup + the required observation period
# + official stats show spend delta exactly zero:
# 1) turn the Canary window back OFF;
# 2) switch to active mode only for normal operation-specific promotion;
# 3) enable ONLY gates/scopes backed by valid evidence.
# -----------------------------------------------------------------------------
# ATELIER_SEARCHAD_ALLOW_ACTIVE_CANARY=false
# ATELIER_SEARCHAD_ACTIVATION_MODE=active
# ATELIER_SEARCHAD_ALLOW_WRITES=true          # only when verified for target scope
# ATELIER_SEARCHAD_ALLOW_CREATES=true         # only when verified for target scope
# ATELIER_SEARCHAD_ALLOW_BATCH_WRITES=true    # only when verified for target scope
# ATELIER_SEARCHAD_ALLOW_ROLLBACK=true        # only when verified for target scope
# ATELIER_SEARCHAD_ALLOW_DELETES=true         # only when verified for target scope
# ATELIER_SEARCHAD_AUTOMATION_MODE=observe    # promote recommend/approve/auto separately
