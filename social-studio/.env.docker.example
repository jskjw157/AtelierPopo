# Docker Compose values
POSTGRES_DB=haar_social
POSTGRES_USER=haar
POSTGRES_PASSWORD=replace-with-a-long-random-password
HAAR_SOCIAL_PORT=3100

# Public HTTPS origin routed to the app by Nginx/Hostinger
APP_BASE_URL=https://social.haar.co.kr

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$12$replace_with_bcrypt_hash
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
MEDIA_SIGNING_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters

MAX_UPLOAD_BYTES=104857600
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://social.haar.co.kr/api/meta/callback
META_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish
