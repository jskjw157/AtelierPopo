NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://haar:change-me@localhost:5432/haar_social
DATABASE_SSL=false
TRUST_PROXY=0

# Admin login. Generate a hash with: npm run hash-password -- "your-password"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$12$replace_with_bcrypt_hash
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
MEDIA_SIGNING_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=104857600

# Meta Graph API. v26.0 was released on 2026-07-29; keep this configurable.
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/meta/callback
META_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish

# Meta Ads: initial rollout is read/draft/approval only. Never enable in CI.
META_ADS_WRITES_ENABLED=false
# Optional read-only MCP: use a separate random secret and an active owner ID.
HAAR_TOOL_BEARER_TOKEN=
HAAR_TOOL_ACTOR_ID=
